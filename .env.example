# Copy this file to .env and fill in real values. NEVER commit .env.
NODE_ENV=development
PORT=8080

# Exact frontend origin(s), comma-separated, no trailing slash, no wildcard.
# Required when NODE_ENV=production. Defaults to http://localhost:3000 in development.
# Also used by the CSRF check: state-changing requests from any other origin are refused.
FRONTEND_ORIGINS=http://localhost:3000

# How many reverse proxies sit in front of the API (0 = none, e.g. local development).
# On Render alone: 1. If the frontend proxies API calls through Vercel rewrites: 2.
# A wrong value breaks rate limiting (everyone looks like one IP) or lets clients fake their IP.
TRUST_PROXY=0

# Session cookie policy.
#  lax  = frontend and API on the same site, OR the frontend proxies /api through Vercel rewrites (recommended)
#  none = frontend and API on different sites (production only, HTTPS required; Safari may still block it)
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.yourschool.edu.ng

# Requests per 15 minutes per IP across the API (health checks excluded). Stricter limits exist on login etc.
# GLOBAL_RATE_LIMIT=600

# Neon, from the Connect dialog of your DEV branch.
# DATABASE_URL = pooled (host contains -pooler), used by the running app.
# DIRECT_URL   = direct (no -pooler), used by Prisma migrations.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# First Faculty Admin, used ONLY by `npx prisma db seed`.
# Password must be 12+ characters. Delete SEED_ADMIN_PASSWORD from .env after seeding.
# SEED_ADMIN_NAME="Faculty Administrator"
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD=""

# Email settings.
# Use the word console while developing (emails print in your terminal), and smtp when Gmail is ready.
# smtp is required in production. Keep the value alone on the line: MAIL_MODE=console
MAIL_MODE=console
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=yourproject@gmail.com
# SMTP_PASS=your-16-character-app-password-without-spaces
# MAIL_FROM="CompuResolve <yourproject@gmail.com>"
