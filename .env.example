# Copy this file to .env and fill in real values. NEVER commit .env.
NODE_ENV=development
PORT=8080

# Exact frontend origin(s), comma-separated, no trailing slash, no wildcard.
# Required when NODE_ENV=production. Defaults to http://localhost:3000 in development.
FRONTEND_ORIGINS=http://localhost:3000

# Set to 1 only when running behind a trusted reverse proxy.
TRUST_PROXY=0

# Neon, from the Connect dialog of your DEV branch.
# DATABASE_URL = pooled (host contains -pooler), used by the running app.
# DIRECT_URL   = direct (no -pooler), used by Prisma migrations.

# First Faculty Admin, used ONLY by `npx prisma db seed`.
# Password must be 12+ characters. Delete SEED_ADMIN_PASSWORD from .env after seeding.
# SEED_ADMIN_NAME="Faculty Administrator"
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD=""
